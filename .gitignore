# Whitelist: only the project's own files are tracked.
# Everything else in this working directory (investigation data, vendor
# installers, capture traces, generated logs, local config) stays out of git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/netwatch.py
!/potato_mine.py
!/mine_core.py
!/webui.py
!/webui.html
!/webui.cmd
!/test_mine_core.py
!/test_netwatch_classify.py
!/netwatch.cmd
!/arm-potato.cmd
!/stop-potato.cmd
!/watch-config.example.json
!/mines.example.json
!/rules.example.txt
!/exclusions.example.txt

# ---- runtime artifacts (already excluded above; listed for clarity) ----
# watch-config.json        local config: real process names and provider values
# mines.json               local mine registry (which directories are guarded)
# rules.txt, exclusions.txt
# potato-mine.log, potato-mine-kills.txt, potato-mine.pid,
# potato-mine-sensor.ps1, potato-mine-auditpol-state.json
# netwatch-webui.log
# watch-ips.json, watch-candidates.txt, watch-blockable.txt
# *.jsonl, *.log, *.etl
